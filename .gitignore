# ──────────────────────────────────────
# XtractNote Monorepo .gitignore
# ──────────────────────────────────────

# Environment variables (NEVER commit these)
.env
.env.local
.env.production
.env.*.local

# ── Frontend (Next.js) ──
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel

# ── Backend (Python) ──
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/venv/
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/

# ── OS files ──
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── IDE ──
.vscode/
.idea/
*.code-workspace

# ── Knowledge-graph output ──
graphify-out/

# ── local context docs (maintained, never committed) ──
XTRACTNOTE-BIBLE.md
CLAUDE.md
SKILLS.md
DESIGN-REGISTRIES.md
DESIGN-REF-LIGHT.md
DESIGN-REF-DARK.md
.graphifyignore

# ── Local agent config ──
.claude/
skills-lock.json

# ── Root-level local tooling (never committed) ──
.mcp.json
/node_modules/

# A package manifest at the repository root is deliberately NOT ignored.
# The apps each own their manifest; one up here means two lockfiles in the
# tree, and the frontend's bundler then resolves its workspace root to the
# whole repository instead of to the app. It keeps working — and exhausts
# memory the moment a route compiles.
#
# One was created here as a side effect of installing local tooling, ignored
# alongside it, and therefore stayed invisible for three weeks. Leaving these
# paths tracked means a stray root manifest shows up in `git status` the day
# it appears rather than as a crash later.

# ── TypeScript / Next build artifacts (generated, never committed) ──
*.tsbuildinfo
next-env.d.ts
