# ──────────────────────────────────────
# XtractNote Monorepo .gitignore
# ──────────────────────────────────────

# Environment variables (NEVER commit these)
.env
.env.local
.env.production
.env.*.local

# ── Frontend (Next.js) ──
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel

# ── Backend (Python) ──
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/venv/
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/

# ── OS files ──
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── IDE ──
.vscode/
.idea/
*.code-workspace

# ── Knowledge-graph output ──
graphify-out/

# ── local context docs (maintained, never committed) ──
XTRACTNOTE-BIBLE.md
CLAUDE.md
SKILLS.md
DESIGN-REGISTRIES.md
DESIGN-REF-LIGHT.md
DESIGN-REF-DARK.md
.graphifyignore

# ── Local agent config ──
.claude/
skills-lock.json

# ── Root-level local tooling (never committed) ──
.mcp.json
/package.json
/package-lock.json
/node_modules/

# ── TypeScript / Next build artifacts (generated, never committed) ──
*.tsbuildinfo
next-env.d.ts
