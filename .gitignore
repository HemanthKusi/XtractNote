# ──────────────────────────────────────
# XtractNote Monorepo .gitignore
# ──────────────────────────────────────

# Environment variables (NEVER commit these)
.env
.env.local
.env.production
.env.*.local

# ── Frontend (Next.js) ──
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel

# ── Backend (Python) ──
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/venv/
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/

# ── OS files ──
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── IDE ──
.vscode/
.idea/
*.code-workspace
